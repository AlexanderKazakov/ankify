{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "mcp_server",
            "type": "debugpy",
            "request": "launch",
            "module": "ankify.mcp.ankify_mcp_server",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python"
        },
        {
            "name": "pytest: non-tts tests (fast)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "tests/",
                "--ignore=tests/unit/tts"
            ],
            "python": "${workspaceFolder}/.venv/bin/python"
        },
        {
            "name": "pytest: tts tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "tests/unit/tts"
            ],
            "python": "${workspaceFolder}/.venv/bin/python"
        },
        {
            "name": "pytest: all tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "tests/"
            ],
            "python": "${workspaceFolder}/.venv/bin/python"
        }
    ]
}
