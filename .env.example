# Ankify environment variables (.env)
# This file is loaded by python-dotenv (load_dotenv()) in the MCP server from the project root.
# Keep this file private; it's already ignored by .gitignore.

# Azure (Text-to-Speech, optional)
ANKIFY__PROVIDERS__AZURE__SUBSCRIPTION_KEY=xxx
ANKIFY__PROVIDERS__AZURE__REGION="westeurope"

# AWS (Text-to-Speech, optional)
ANKIFY__PROVIDERS__AWS__ACCESS_KEY_ID=xxx
ANKIFY__PROVIDERS__AWS__SECRET_ACCESS_KEY=xxx
ANKIFY__PROVIDERS__AWS__REGION="eu-central-1"